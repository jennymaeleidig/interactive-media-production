// `checkJs` over the chat's own JavaScript, so the modules that ship bytes or
// decide what they are (`chat-engine.mjs` against the turn vocabulary in
// `lib/chat-turn.mjs`, the block inventory, the runtime builder, the
// published bytes, the artifact check) are typechecked where they lie, by
// annotation alone.
//
// The scope is deliberately not `scripts/**`. A listed module's own imports are
// pulled into the program too; the ones fixable by annotation are listed outright
// so the checked set is what this file says it is.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "checkJs": true,
    "noEmit": true,
    "incremental": false,
    // `chat-engine.mjs` imports the generated `chat-program.json`, whose type is
    // declared beside it as `chat-program.d.json.ts`
    "allowArbitraryExtensions": true
  },
  "include": [
    "lib/chat-turn.mjs",
    "scripts/chat-engine.mjs",
    "lib/chat-blocks.mjs",
    "scripts/build-chat-runtime.mjs",
    "scripts/chat-assets.mjs",
    "test/artifact.mjs",
    "scripts/globals.d.ts"
  ]
}
