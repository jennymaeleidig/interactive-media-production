// `checkJs` over the chat's own JavaScript, so the modules that ship bytes or
// decide what they are (`chat-widget.js` against the single turn-shape
// declaration in `pipeline/chat-turn.mjs`, the runtime builder, the published
// bytes and their no-network rule, the artifact check) are typechecked where
// they lie, by annotation alone.
//
// The scope is deliberately not `pipeline/**`. A listed module's own imports are
// pulled into the program too; the ones fixable by annotation are listed outright
// so the checked set is what this file says it is.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "checkJs": true,
    "noEmit": true,
    "incremental": false,
    // `chat-engine.mjs` imports the generated `chat-program.json`, whose type is
    // declared beside it as `chat-program.d.json.ts`
    "allowArbitraryExtensions": true
  },
  "include": [
    "pipeline/chat-turn.mjs",
    "pipeline/chat-engine.mjs",
    "pipeline/build-chat-runtime.mjs",
    "pipeline/chat-widget.js",
    "pipeline/chat-assets.mjs",
    "pipeline/chat-source.mjs",
    "regression/artifact.mjs",
    "pipeline/globals.d.ts"
  ]
}
